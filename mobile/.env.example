# Copy to .env and fill from your Supabase project settings (API section).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# PostHog analytics (optional — app runs without it). Public project key.
EXPO_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_KEY
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error monitoring (optional). Create a project in Sentry, paste its DSN.
EXPO_PUBLIC_SENTRY_DSN=
